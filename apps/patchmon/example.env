# Host volume paths
HOST_PATCHMON_DB_PATH=/cluster/patchmon/database
HOST_PATCHMON_REDIS_PATH=/cluster/patchmon/redis
HOST_PATCHMON_BACKUP_PATH=/cluster/patchmon/backup

# Image tags
PATCHMON_TAG=1.2
POSTGRES_TAG=17-alpine
REDIS_TAG=7-alpine
GUACD_TAG=1.6.0

# Database configuration
POSTGRES_USER=patchmon_user
POSTGRES_DB=patchmon_db
# Match the value of the `patchmon_postgres_password` secret.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
# Match the value of the `patchmon_redis_password` secret.
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=

# PatchMon secrets (values must match the corresponding Docker secrets)
# Generate with: openssl rand -hex 64
JWT_SECRET=
SESSION_SECRET=
AI_ENCRYPTION_KEY=

# Proxy configuration
ENTRYPOINT=
DOMAIN=
CORS_ORIGIN=
TZ=UTC

# Backup configuration
## (use s for seconds, m for minutes and h for hours)
BACKUP_FREQUENCY=24h
RETENTION_DAYS=14

# NFS configuration
NFS_SHARE_IP=
