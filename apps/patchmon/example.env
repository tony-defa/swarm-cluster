# Host volume paths
HOST_PATCHMON_DB_PATH=/cluster/patchmon_data/database
HOST_PATCHMON_REDIS_PATH=/cluster/patchmon_data/redis
HOST_PATCHMON_BACKUP_PATH=/cluster/patchmon_data/backup

# Image tags
PATCHMON_TAG=1.2
POSTGRES_TAG=17-alpine
REDIS_TAG=7-alpine
GUACD_TAG=1.6.0

# Database configuration
POSTGRES_USER=patchmon_user
POSTGRES_DB=patchmon_db
REDIS_PORT=6379
REDIS_DB=0

# PatchMon secrets are provided via Docker secrets (see README)
# - patchmon_postgres_password
# - patchmon_redis_password
# - patchmon_jwt_secret
# - patchmon_session_secret
# - patchmon_ai_encryption_key

# Proxy configuration
ENTRYPOINT=
DOMAIN=
# CORS_ORIGIN must include both public URL and internal service URL
# CORS_ORIGIN=https://patchmon.example.com,http://patchmon:3000
CORS_ORIGIN=
TZ=UTC

# Backup configuration
## (use s for seconds, m for minutes and h for hours)
BACKUP_FREQUENCY=24h
RETENTION_DAYS=14

# NFS configuration
NFS_SHARE_IP=
