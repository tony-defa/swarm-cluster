# =============================================================================
# PatchMon - Environment configuration template
# =============================================================================
# Copy this file to `.env` and adjust values before deploying:
#
#   cp example.env .env
#   $EDITOR .env
#   ./deploy-stack.sh apps/patchmon/patchmon.yml patchmon
#
# All required Docker secrets must also be created (see README.md).
# =============================================================================

# -----------------------------------------------------------------------------
# Host volume paths
# -----------------------------------------------------------------------------
HOST_PATCHMON_DB_PATH=/cluster/patchmon_data/database
HOST_PATCHMON_REDIS_PATH=/cluster/patchmon_data/redis
HOST_PATCHMON_BACKUP_PATH=/cluster/patchmon_data/backup

# -----------------------------------------------------------------------------
# Image tags
# -----------------------------------------------------------------------------
# Pin PatchMon to a specific minor release. See
# https://github.com/PatchMon/PatchMon/releases for available versions.
PATCHMON_TAG=1.2
POSTGRES_TAG=17-alpine
REDIS_TAG=7-alpine
GUACD_TAG=1.6.0

# -----------------------------------------------------------------------------
# Database configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=patchmon_user
POSTGRES_DB=patchmon_db
# POSTGRES_PASSWORD is supplied via the `patchmon_postgres_password` Docker
# secret. Keep the value of POSTGRES_PASSWORD below in sync with the secret
# so that the server service (which reads POSTGRES_PASSWORD from env) and
# the database service (which reads POSTGRES_PASSWORD_FILE) agree.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Redis configuration
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD is supplied via the `patchmon_redis_password` Docker secret.
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# PatchMon server secrets (all required, supplied via Docker secrets)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 64
JWT_SECRET=
SESSION_SECRET=
AI_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# CORS / Frontend URL configuration
# -----------------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API. Must include
# the public URL you will use to access PatchMon, and the local in-stack
# service URL.
CORS_ORIGIN=https://patchmon.example.com,http://patchmon:3000

# -----------------------------------------------------------------------------
# Proxy configuration
# -----------------------------------------------------------------------------
ENTRYPOINT=websecure
DOMAIN=patchmon.example.com

# -----------------------------------------------------------------------------
# General configuration
# -----------------------------------------------------------------------------
# Timezone (e.g. Europe/Berlin, UTC)
TZ=UTC
# PatchMon log level: debug | info | warn | error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Backup configuration
# -----------------------------------------------------------------------------
# Frequency between PostgreSQL dumps (sleep argument; e.g. 24h, 12h, 168h).
BACKUP_FREQUENCY=24h
# Number of days to keep database dumps.
RETENTION_DAYS=14

# -----------------------------------------------------------------------------
# NFS configuration (optional - uncomment the volume lines in patchmon.yml)
# -----------------------------------------------------------------------------
# NFS_SHARE_IP=
